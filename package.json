{
  "name": "table-ocr-print",
  "version": "1.0.0",
  "description": "표 이미지를 OCR/VLM으로 인식해 영어/한글 분리 인쇄본을 만드는 Windows용 Electron 앱",
  "main": "main.js",
  "author": "",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "tsc && electron .",
    "dist": "tsc && electron-builder --win"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.local.tableocrprint",
    "productName": "단어 시험지 만들기",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "scripts/**/*",
      "!**/*.ts"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
